# --- Site address and search ---
# Public address of the site. Set it once you have a custom domain.
# On Vercel it falls back to VERCEL_PROJECT_PRODUCTION_URL automatically.
NEXT_PUBLIC_SITE_URL=

# Google Search Console "HTML tag" verification: paste only the content="..." value.
GOOGLE_SITE_VERIFICATION=

# --- Contact form (server-only: never prefix these with NEXT_PUBLIC_) ---
# Supabase project URL, and the SECRET (service role) key from Project Settings > API Keys.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend API key for the email notification.
RESEND_API_KEY=

# Optional. Defaults to the email in data/profile.ts. Without a verified Resend domain this
# must be your Resend account's email address.
CONTACT_TO_EMAIL=
# Optional. Defaults to "Portfolio <onboarding@resend.dev>".
CONTACT_FROM_EMAIL=
# Optional. Salt for the IP hash used in rate limiting. Defaults to the service role key.
MESSAGE_HASH_SALT=
